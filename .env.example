# Copie este arquivo para ".env" e preencha só o que precisar.
# NUNCA faça commit do arquivo ".env" (só deste .example).
#
# NADA aqui é obrigatório pra rodar o sistema — sem ".env" nenhum, tudo
# funciona com os valores padrão (a fonte de leads é o extrato local da
# Receita Federal em data/rf_fortaleza_*.csv, não uma API paga).

# OPCIONAL / legado — só usado se você reativar os módulos antigos
# etapa1_maps.py (Google Places) e etapa2_cnpj.py (Google Custom Search).
# O pipeline padrão (pipeline.py) não chama nenhum dos dois.
GOOGLE_MAPS_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Caminho do banco SQLite (relativo à raiz do projeto).
DB_PATH=data/leads.db

# Pasta onde o painel React buildado (frontend/dist) é servido a partir.
FRONTEND_DIST_DIR=frontend/dist

# Intervalo mínimo (segundos) entre consultas consecutivas ao Portal SEUMA.
SEUMA_REQUEST_DELAY_SECONDS=4

# Rodar o navegador do Playwright visível (false) ou headless (true).
SEUMA_HEADLESS=true

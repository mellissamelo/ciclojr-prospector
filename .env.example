# Copie este arquivo para ".env" e preencha com suas chaves.
# NUNCA faça commit do arquivo ".env" (só deste .example).

# Google Cloud - Places API (New) habilitada, faturamento ativo no projeto.
GOOGLE_MAPS_API_KEY=

# Google Programmable Search Engine (Custom Search JSON API).
# 1. Crie um mecanismo de busca em https://programmablesearchengine.google.com/
#    configurado para "Search the entire web".
# 2. Habilite a "Custom Search API" no Google Cloud e gere uma API key.
# 3. Cota gratuita: 100 buscas/dia. Acima disso, cobrança por uso.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Caminho do banco SQLite (relativo à raiz do projeto).
DB_PATH=data/leads.db

# Pasta onde o painel React buildado (frontend/dist) é servido a partir.
FRONTEND_DIST_DIR=frontend/dist

# Intervalo mínimo (segundos) entre consultas consecutivas ao Portal SEUMA.
SEUMA_REQUEST_DELAY_SECONDS=4

# Rodar o navegador do Playwright visível (false) ou headless (true).
SEUMA_HEADLESS=true
